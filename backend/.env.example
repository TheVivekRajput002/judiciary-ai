DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require
DATABASE_URL_DIRECT=postgresql+asyncpg://user:password@host/dbname?ssl=require

LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b

# Embeddings: 'fastembed' (free local ONNX, 0 payment, 0 API keys required) or 'voyage'
EMBEDDING_PROVIDER=fastembed
VOYAGE_API_KEY=your_voyage_api_key_here_optional

TAVILY_API_KEY=your_tavily_api_key_here

FRONTEND_ORIGIN=http://localhost:5173
